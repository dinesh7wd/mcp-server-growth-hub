# ── Server ─────────────────────────────────────────────────
# Public base URL (origin only, no trailing slash). Must match DNS + TLS.
# https:// is required; http:// is only accepted for localhost / 127.0.0.1.
# Local:  http://127.0.0.1:3004
# Prod:   https://mcp.your-domain.com
BASE_URL=https://mcp.your-domain.com

# Listen port for bare `npm start`. Docker Compose pins PORT=3000 inside the
# container (host 3004 → container 3000), so this value only matters locally.
PORT=3004

# 32-byte key, base64. Generate: openssl rand -base64 32
# NEVER commit the real value — set per machine / VPS only.
ENCRYPTION_KEY=

# Optional: the old key while rotating ENCRYPTION_KEY. Stored Google tokens
# written with the old key keep working and are re-encrypted on next use.
ENCRYPTION_KEY_PREVIOUS=

# SQLite file path. Docker Compose overrides this to /data/growth-hub.db.
DB_PATH=./data/growth-hub.db

# ── Google OAuth (Web application client) ──────────────────
# Add redirect URI in GCP:
#   {BASE_URL}/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict who can log in (comma-separated domains).
# Workspace accounts are matched on their hosted domain (hd), others on
# their verified email domain. Re-checked on every token refresh.
# e.g. ALLOWED_DOMAINS=your-domain.com,client1.com
# With an https BASE_URL the server refuses to start if this is empty,
# unless ALLOW_ANY_GOOGLE_ACCOUNT=true (any Google account may connect).
ALLOWED_DOMAINS=
ALLOW_ANY_GOOGLE_ACCOUNT=false

# ── OAuth / transport security ─────────────────────────────
# Private-use redirect URI schemes accepted at client registration
# (http://localhost|127.0.0.1|[::1] is always accepted).
ALLOWED_REDIRECT_SCHEMES=cursor,vscode,vscode-insiders,claude

# Hosts allowed in https:// redirect URIs (checked at /register and /authorize).
# "*.example.com" also allows subdomains; "*" allows any host (not recommended:
# anyone could register a client that sends your users' codes to their site).
ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com,vscode.dev,insiders.vscode.dev

# Browser Origins allowed to call /mcp (requests without an Origin header,
# i.e. non-browser clients, are always allowed). "host:*" = any port, "*" = any.
ALLOWED_ORIGINS=https://claude.ai,https://claude.com,http://localhost:*,http://127.0.0.1:*

# Extra Host header values accepted (BASE_URL's host is always allowed; /health is exempt).
# Needed only if a proxy does not forward the original Host header.
ALLOWED_HOSTS=

# Lifetime of MCP refresh tokens (rotated on every use, so active users never expire).
REFRESH_TOKEN_TTL_DAYS=60

# ── Feature flags (true/false; 1/0, yes/no, on/off also accepted) ──
DRIVE_ENABLED=true
GMAIL_ENABLED=true
# gmail_send tool + gmail.send scope. Off by default (drafts only).
GMAIL_SEND_ENABLED=false

# ── Optional: indexing (off by default; users reconnect once after enabling)
# gsc_submit_sitemap tool + webmasters (write) scope.
GSC_SUBMIT_ENABLED=false
# indexing_* tools + indexing scope. Needs the Web Search Indexing API enabled.
# Officially for JobPosting/BroadcastEvent pages; ~200 publish requests/day per GCP project.
INDEXING_ENABLED=false

# ── Phase 2: Google Ads (enable after developer token approved)
ADS_DEVELOPER_TOKEN=
# Optional: MCC login customer id (10 digits)
ADS_LOGIN_CUSTOMER_ID=
# Google Ads REST API version. Check the sunset schedule:
# https://developers.google.com/google-ads/api/docs/sunset-dates
ADS_API_VERSION=v25

# ── Phase 2: Google Business Profile (enable after quota approved)
GBP_ENABLED=false
